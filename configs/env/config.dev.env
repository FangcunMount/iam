# Database Environment Configuration for iam contracts System
# 数据库环境配置文件

# MySQL配置（与 build/docker/infra/dev.env 保持一致）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=infra_dev
MYSQL_PASSWORD=dev_pass_123
MYSQL_DATABASE=iam
MYSQL_DBNAME=iam

# Redis 配置
## 用于缓存、令牌等
REDIS_CACHE_HOST=127.0.0.1
REDIS_CACHE_PORT=6379
REDIS_CACHE_USERNAME=app
REDIS_CACHE_PASSWORD=dev_app_123
REDIS_CACHE_DB=0

# JWT 签名使用 JWKS (RS256) 非对称密钥，自动生成并持久化到 /app/data/keys

# IDP模块加密密钥（32字节，用于加密敏感信息如微信AppSecret）
# ⚠️ 必须与 GitHub Secrets 中的 IPD_ENCRYPTION_KEY 保持一致
# ⚠️ 如果不设置，将使用默认密钥（仅用于开发环境）
# IAM_APISERVER_IDP_ENCRYPTION_KEY=your-key-here

# Docker网络配置
DOCKER_NETWORK_NAME=iam-network

# 时区配置
TZ=Asia/Shanghai

# 数据路径配置
MYSQL_DATA_PATH=/data/mysql/iam/data
MYSQL_LOGS_PATH=/data/logs/iam/mysql
REDIS_DATA_PATH=/data/redis/iam/data
REDIS_LOGS_PATH=/data/logs/iam/redis

# =============================================================================
# 备份配置
# =============================================================================
BACKUP_PATH=/data/backups/iam
BACKUP_RETENTION_DAYS=30

# =============================================================================
# 应用配置
# =============================================================================
APP_ENV=development
APP_DEBUG=true 
